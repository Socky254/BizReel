{
  "name": "bizreel",
  "version": "1.0.1",
  "description": "BizReel Enterprise Desktop Client",
  "author": "BizReel Team",
  "main": "expo-router/entry",
  "private": true,
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "clean": "expo start --clear",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "format": "prettier --write .",
    "type-check": "tsc --noEmit",
    "build:android": "npx expo prebuild --platform android && cd android && ./gradlew assembleRelease",
    "build:windows": "npx expo export --platform web && node fix-paths.js && npx electron-builder"
  },
  "build": {
    "appId": "com.bizreel.desktop",
    "productName": "BizReel",
    "extraMetadata": {
      "main": "electron-main.js"
    },
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron-main.js",
      "assets/**/*"
    ],
    "win": {
      "target": ["nsis", "portable"],
      "icon": "assets/icon.png"
    }
  },
  "dependencies": {
    "@expo/metro-runtime": "~4.0.1",
    "@expo/vector-icons": "~14.0.4",
    "@react-native-async-storage/async-storage": "1.23.1",
    "@react-native-community/cli-server-api": "^20.1.3",
    "@supabase/supabase-js": "^2.49.8",
    "@tanstack/query-async-storage-persister": "^5.28.9",
    "@tanstack/react-query": "^5.28.9",
    "@tanstack/react-query-persist-client": "^5.28.9",
    "base64-arraybuffer": "^1.0.2",
    "expo": "~52.0.23",
    "expo-asset": "~11.0.1",
    "expo-av": "~15.0.1",
    "expo-build-properties": "~0.13.3",
    "expo-constants": "~17.0.8",
    "expo-dev-client": "~5.0.20",
    "expo-file-system": "~18.0.7",
    "expo-font": "~13.0.2",
    "expo-haptics": "~14.0.1",
    "expo-image": "~2.0.7",
    "expo-image-picker": "~16.0.3",
    "expo-linear-gradient": "~14.0.2",
    "expo-linking": "~7.0.3",
    "expo-local-authentication": "~15.0.2",
    "expo-media-library": "~17.0.6",
    "expo-navigation-bar": "~4.0.9",
    "expo-notifications": "~0.29.14",
    "expo-router": "~4.0.17",
    "expo-sharing": "~13.0.1",
    "expo-splash-screen": "~0.29.13",
    "expo-status-bar": "~2.0.0",
    "expo-system-ui": "~4.0.9",
    "expo-updates": "~0.27.5",
    "expo-video-thumbnails": "~9.0.3",
    "fs-extra": "^11.3.5",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-native": "^0.76.9",
    "react-native-agora": "^4.5.4",
    "react-native-error-boundary": "^3.1.0",
    "react-native-gesture-handler": "~2.20.2",
    "react-native-reanimated": "~3.16.1",
    "react-native-safe-area-context": "4.12.0",
    "react-native-screens": "~4.4.0",
    "react-native-url-polyfill": "^2.0.0",
    "react-native-web": "~0.19.13",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@babel/core": "^7.25.0",
    "@testing-library/jest-native": "^5.4.3",
    "@testing-library/react-native": "^12.4.3",
    "@types/react": "~18.3.3",
    "eas-cli": "^14.1.0",
    "electron": "^30.0.0",
    "electron-builder": "^24.13.3",
    "eslint": "^8.57.0",
    "eslint-config-expo": "~8.0.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "jest": "^29.7.0",
    "jest-expo": "~52.0.0",
    "prettier": "^3.2.5",
    "react-test-renderer": "18.3.1",
    "typescript": "~5.5.4"
  }
}
