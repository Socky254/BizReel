{
  "expo": {
    "name": "BizReel",
    "slug": "BizReel",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#050508",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "newArchEnabled": false,
    "jsEngine": "hermes",
    "scheme": "bizreel",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.bizreel.app",
      "backgroundColor": "#000000",
      "icon": "./assets/icon.png",
      "infoPlist": {
        "NSCameraUsageDescription": "BizReel needs camera access to record business reels.",
        "NSMicrophoneUsageDescription": "BizReel needs microphone access for reel audio.",
        "NSPhotoLibraryUsageDescription": "BizReel needs access to your photos to upload business product images."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/adaptive-icon.png",
        "monochromeImage": "./assets/adaptive-icon.png"
      },
      "package": "com.bizreel.app",
      "googleServicesFile": "./google-services.json",
      "shortcuts": [
        {
          "id": "launch-reel",
          "shortLabel": "Launch Reel",
          "longLabel": "Launch New Business Reel",
          "icon": "./assets/adaptive-icon.png",
          "intent": {
            "targetPackage": "com.bizreel.app",
            "targetClass": "com.bizreel.app.MainActivity",
            "action": "android.intent.action.VIEW",
            "data": "bizreel://upload"
          }
        },
        {
          "id": "view-insights",
          "shortLabel": "Insights",
          "longLabel": "View Market Insights",
          "icon": "./assets/adaptive-icon.png",
          "intent": {
            "targetPackage": "com.bizreel.app",
            "targetClass": "com.bizreel.app.MainActivity",
            "action": "android.intent.action.VIEW",
            "data": "bizreel://index"
          }
        }
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "data": [
            {
              "scheme": "bizreel"
            },
            {
              "scheme": "https",
              "host": "dist-tau-five-42.vercel.app"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ],
      "permissions": [
        "INTERNET",
        "CAMERA",
        "RECORD_AUDIO",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "MODIFY_AUDIO_SETTINGS",
        "POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "favicon": "./assets/icon.png",
      "baseUrl": ""
    },
    "plugins": [
      "expo-router",
      "expo-image-picker",
      "expo-av",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true,
            "enableProguardInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "kotlinCompilerMaxHeapSize": "2048M"
          }
        }
      ]
    ],
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "87c5f2bf-167e-4632-b462-45c25a74c0cb"
      }
    },
    "experiments": {
      "typedRoutes": true
    },
    "owner": "biztech254"
  }
}
